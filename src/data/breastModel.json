{"version":2,"unitsPerMm":0.006953,"rref":170.0,"cell":2.0,"taperMm":50.0,"taperMedialMm":55.0,"taperReferenceMm":160.0,"interpolation":"catmull-rom","gate":{"belowHingeMm":120.0,"fadeMm":40.0,"windowFadeMm":10.0},"bin":"models/hybrid/breast-chart.bin","byteLength":155172,"flow":{"shear":7.0,"shearFold":20.0,"shearBlend":[5.0,65.0],"rise":60.0,"decel":[-55.0,15.0],"lmin":0.7,"stepMm":4.0},"tilt":{"reach":60.0,"fade":[0.0,60.0],"stepMm":4.0},"growth":{"shear":15.0,"blend":20.0,"hangMm":120.0,"steps":6,"fadeMm":8.0},"skin":"hra_VH_F_skin","states":[{"id":"ptose-1","label":"Ptose grau I com hipertrofia leve","short":"Ptose I","descent":50.0,"tilt":0.0,"growth":{"depth":1.129,"width":1.08,"length":1.05,"hang":0.0},"description":"Mamilo na altura do sulco inframamário, ainda acima do contorno inferior da mama. O polo superior começa a esvaziar, o polo inferior ultrapassa o sulco e o volume já é maior."},{"id":"ptose-2","label":"Ptose grau II com hipertrofia moderada","short":"Ptose II","descent":77.0,"tilt":0.0,"growth":{"depth":1.236,"width":1.16,"length":1.12,"hang":0.0},"description":"Mamilo abaixo do sulco, mas acima do contorno inferior. Polo superior plano, glândula deslizada sobre a fáscia, polo inferior alongado e mama mais pesada: o caso típico da mamoplastia redutora."},{"id":"ptose-3","label":"Ptose grau III com hipertrofia acentuada","short":"Ptose III","descent":77.0,"tilt":1.3,"growth":{"depth":1.567,"width":1.4,"length":1.3,"hang":0.5},"description":"Mamilo no contorno mais baixo da mama, apontando para baixo. A mama, volumosa, pende sobre a parede abdominal e a aréola se alonga. O tronco começa a ganhar peso, como é comum nesse grau."},{"id":"g3","label":"G3: ptose grau III com hipertrofia grau III","short":"G3","descent":80.0,"tilt":1.3,"growth":{"depth":2.666,"width":1.85,"length":1.3,"hang":0.5},"resultMl":700,"description":"Hipertrofia grau III de Berrocal Revueltas: a redução retira de 800 a 1.000 g por mama. Mama larga e pendente, mamilo no contorno mais baixo, fúrcula–mamilo acima de 40 cm. Tronco com obesidade, comum nessas pacientes: abdome, flancos e rolos lateral e dorsal mais espessos."},{"id":"g4","label":"G4: ptose grau III com gigantomastia (hipertrofia grau IV)","short":"G4","descent":84.0,"tilt":1.4,"growth":{"depth":3.233,"width":2.0,"length":1.4,"hang":0.6},"resultMl":850,"description":"Gigantomastia: hipertrofia grau IV de Berrocal Revueltas, a redução retira mais de 1.000 g por mama. Fúrcula–mamilo de 44 cm, faixa em que muitos autores consideram o enxerto livre do complexo areolopapilar. Tronco com obesidade mais acentuada; a bolsa se apoia no abdome."}],"sides":{"op":{"s":1.0,"xc":35.8,"zc":-20.3,"y0":-11.1,"u0":16.0,"v0":-230.0,"nu":101,"nv":201,"byteOffset":0,"qmin":30.0,"qstep":0.005,"thicknessOffset":40602,"foldRange":[36.0,196.0],"fold":[-16.021,-16.044,-16.085,-16.157,-16.276,-16.458,-16.724,-17.09,-17.567,-18.158,-18.855,-19.644,-20.507,-21.425,-22.386,-23.384,-24.422,-25.504,-26.635,-27.815,-29.038,-30.295,-31.572,-32.853,-34.123,-35.368,-36.578,-37.748,-38.874,-39.957,-40.997,-41.996,-42.953,-43.864,-44.727,-45.538,-46.292,-46.989,-47.626,-48.207,-48.732,-49.206,-49.635,-50.023,-50.373,-50.686,-50.96,-51.19,-51.371,-51.496,-51.559,-51.559,-51.496,-51.371,-51.19,-50.96,-50.686,-50.373,-50.023,-49.634,-49.204,-48.727,-48.196,-47.605,-46.947,-46.215,-45.401,-44.499,-43.501,-42.403,-41.202,-39.903,-38.514,-37.048,-35.524,-33.964,-32.391,-30.826,-29.284,-27.776,-26.308,-24.882,-23.499,-22.163,-20.881,-19.669,-18.547,-17.536,-16.656,-15.921,-15.333,-14.884,-14.56,-14.338,-14.194,-14.105,-14.054,-14.026,-14.012,-14.005,-14.002],"hinge":[-33.79,-33.801,-33.822,-33.858,-33.917,-34.009,-34.142,-34.325,-34.563,-34.859,-35.207,-35.602,-36.033,-36.492,-36.973,-37.472,-37.991,-38.532,-39.097,-39.687,-40.299,-40.927,-41.566,-42.206,-42.841,-43.464,-44.069,-44.654,-45.217,-45.758,-46.278,-46.778,-47.256,-47.712,-48.143,-48.549,-48.926,-49.274,-49.593,-49.883,-50.146,-50.383,-50.597,-50.791,-50.966,-5